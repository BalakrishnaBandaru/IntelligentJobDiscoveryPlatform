# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. ".env" is git-ignored.
#   cp .env.example .env    (PowerShell:  Copy-Item .env.example .env)
#
# Docker Compose reads ".env" automatically and injects these into the
# containers. These three values are the single source of truth: the app's
# Spring datasource is derived from them in docker-compose.yml.
# -----------------------------------------------------------------------------

# PostgreSQL database name / credentials (used by both the db container
# and the app container).
POSTGRES_DB=jobdiscovery
POSTGRES_USER=jobdiscovery
POSTGRES_PASSWORD=change_me_for_local_dev

# -----------------------------------------------------------------------------
# External API credentials — NOT needed until later phases. Placeholders only;
# put your real keys here (never in code). Uncomment as we reach each phase.
# -----------------------------------------------------------------------------

# Phase 1 — Adzuna (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Optional tuning (defaults: 30 days, sort by date). Uncomment to override.
# max-days-old = recency window in days (0 disables); sort = date|relevance|salary|hybrid
#ADZUNA_MAX_DAYS_OLD=30
#ADZUNA_SORT_BY=date

# Phase 2+ — Jooble (https://jooble.org/api/about) — key is used in the URL path
# JOOBLE_API_KEY=your_jooble_api_key

# Arbeitnow needs no key.

# Phase 6 - Telegram digest.
#   1. Message @BotFather on Telegram, /newbot, copy the token.
#   2. Message your new bot once (it cannot message you first), then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
#   3. Set all three below and recreate the app container.
# Off unless TELEGRAM_ENABLED is true AND both values are set. A notification
# failure never affects the fetch that triggered it.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Below this score a match is not worth interrupting you for.
#TELEGRAM_MIN_SCORE=60
# Also send after the startup fetch, not only on the 06:00 cron. Worth keeping
# true on a laptop, where the container is rarely up at 06:00.
#TELEGRAM_SEND_ON_STARTUP=true

# Phase 5b - match explanations.
#   none   = no model. The templated explainer answers, so &explain=true works
#            out of the box with no key and no download. This is the default.
#   ollama = free local model. Needs:
#              docker compose --profile llm up -d ollama
#              docker exec jobdiscovery-ollama ollama pull llama3.2:3b
#   claude = Anthropic API. Billed per token from a PREPAID CREDIT BALANCE.
#            A Claude Pro subscription does NOT fund this.
EXPLANATION_PROVIDER=none
# templated | error - what happens when the provider cannot answer.
EXPLANATION_FALLBACK=templated
# Only needed when EXPLANATION_PROVIDER=claude.
ANTHROPIC_API_KEY=
